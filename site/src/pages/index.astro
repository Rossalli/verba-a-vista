---
import Base from "../layouts/Base.astro";
import Resumo from "../components/Resumo.astro";
import CartaoRisco from "../components/CartaoRisco.astro";
import BarrasPerdas from "../components/BarrasPerdas.astro";
import { CONTATO_EMAIL } from "../config.js";
import { carregarPublicado, formatarData, formatarDataHora, url } from "../lib/dados.js";
import { carregarTaxonomia } from "../lib/taxonomia.js";
import { rotuloSituacao } from "../lib/verba.js";
import { emRiscoAgora, evitaveis, fraseEvitavel, formatarTitulo, perdasPorMotivo, resumir, ultimasMudancas } from "../lib/resumo.js";

const publicado = carregarPublicado();
const taxonomia = carregarTaxonomia();
const verbas = publicado.verbas;
const resumo = resumir(verbas);
const risco = emRiscoAgora(verbas, 6);
const grupos = perdasPorMotivo(verbas, taxonomia);
const evitavel = evitaveis(verbas);
const mudancas = ultimasMudancas(verbas, 6);
const inicioHistorico = verbas.flatMap((v) => v.historico.map((h) => h.data)).sort()[0];
const dataCompleta = (iso) => formatarData(`${iso}T12:00:00-03:00`);
const dia = (iso) => dataCompleta(iso).slice(0, 5);
---

<Base rota="/">
  <section class="abertura">
    <span class="mono data">Atualizado em {formatarDataHora(publicado.atualizado_em)} · verbas federais</span>
    <h1>Quanto dinheiro federal Neves Paulista pode receber, quanto já chegou e quanto foi perdido.</h1>
    <p class="tese">
      Acompanhamos convênios, emendas parlamentares e repasses do Governo Federal para o município, desde a oportunidade até a prestação de contas. Quando uma verba é perdida, explicamos o motivo com o documento oficial.
    </p>
  </section>

  <Resumo resumo={resumo} />
  {resumo.oportunidades.n > 0 && (
    <p class="oportunidades">
      Além disso, {resumo.oportunidades.n} {resumo.oportunidades.n === 1 ? "oportunidade aberta" : "oportunidades abertas"} (sem valor definido ainda).{" "}
      <a href={url("/verbas/?status=oportunidade")}>Ver oportunidades</a>
    </p>
  )}

  {risco.length > 0 && (
    <section class="bloco">
      <div class="titulo-bloco">
        <h2>Em risco agora</h2>
        <a href={url("/verbas/?risco=1")}>Ver todas as {resumo.risco.n} verbas em risco</a>
      </div>
      <p class="apoio">Verbas que ainda podem ser salvas. O alerta aparece quando um prazo vence em menos de 60 dias, o município tem pendência no CAUC ou uma obra fica parada.</p>
      <div class="cartoes">
        {risco.map((v) => <CartaoRisco verba={v} />)}
      </div>
    </section>
  )}

  <div class="duas-colunas">
    <section class="painel">
      <div class="cabeca-painel">
        <h2 class="h2-menor">Onde o dinheiro se perdeu</h2>
        <span class="apoio-curto">Valor perdido por motivo, desde 2024</span>
      </div>
      {grupos.length > 0 ? <BarrasPerdas grupos={grupos} /> : <p>Nenhuma verba foi perdida no período.</p>}
      <span class="apoio-curto">
        {fraseEvitavel(evitavel, "Nenhuma perda tem ainda o motivo documentado e revisado; enquanto isso, o valor aparece como “motivo em apuração”.")}
      </span>
    </section>

    <section class="mudancas">
      <h2 class="h2-menor">Últimas mudanças</h2>
      {mudancas.length > 0 ? (
        <ol>
          {mudancas.map((m) => (
            <li>
              <span class="mono dia">{dia(m.data)}</span>
              <span><a href={url(`/verbas/${m.verba.id}/`)}><strong>{formatarTitulo(m.verba.nome)}</strong></a>: {rotuloSituacao(m.de, taxonomia)} → {rotuloSituacao(m.para, taxonomia)}.</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="apoio-curto">Ainda não há mudanças de situação registradas: o histórico começou em {dataCompleta(inicioHistorico)} e cresce a cada coleta.</p>
      )}
    </section>
  </div>

  <a class="botao-todas" href={url("/verbas/")}>Ver todas as verbas</a>

  <section id="como-funciona" class="como">
    <div>
      <h3>De onde vêm os dados</h3>
      <p>Transferegov, Obrasgov, Portal da Transparência e CAUC do Tesouro Nacional, consultados todos os dias. <a href={url("/como-funciona/")}>Saiba mais</a>.</p>
    </div>
    <div>
      <h3>Como explicamos as perdas</h3>
      <p>Uma IA lê os documentos oficiais e escreve um rascunho com citações. Uma pessoa revisa antes de publicar. Sem documento, o motivo fica “em apuração”.</p>
    </div>
    <div>
      <h3>Encontrou um erro?</h3>
      <p>
        {CONTATO_EMAIL
          ? <>Escreva para <a href={`mailto:${CONTATO_EMAIL}`}>{CONTATO_EMAIL}</a> com o link da verba. Corrigimos e registramos a correção na página.</>
          : <>O canal de contato será divulgado em breve. Quando houver, corrigimos o erro e registramos a correção na página da verba.</>}
      </p>
    </div>
  </section>
</Base>

<style>
  .abertura { display: flex; flex-direction: column; gap: 14px; max-width: 820px; }
  .data { font-size: 13px; color: var(--tinta-suave); }
  .tese { margin: 0; font-size: 18px; color: var(--tinta-2); max-width: 64ch; }
  .oportunidades { margin: -32px 0 0; color: var(--tinta-suave); font-size: 15px; }

  .bloco { display: flex; flex-direction: column; gap: 16px; }
  .titulo-bloco { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  .titulo-bloco a { font-weight: 700; display: inline-flex; align-items: center; min-height: 44px; }
  .apoio { margin: 0; color: var(--tinta-suave); max-width: 70ch; }
  .cartoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }

  .duas-colunas { display: flex; flex-wrap: wrap; gap: 32px; }
  .painel { flex: 3 1 420px; min-width: 0; background: var(--superficie); border: 1px solid var(--linha); border-radius: var(--raio); padding: 24px; display: flex; flex-direction: column; gap: 18px; }
  .cabeca-painel { display: flex; flex-direction: column; gap: 4px; }
  .h2-menor { font-size: 26px; }
  .apoio-curto { color: var(--tinta-suave); font-size: 14px; }
  .mudancas { flex: 2 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .mudancas ol { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--linha); }
  .mudancas li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-top: 1px solid var(--linha); }
  .dia { font-size: 13px; color: var(--tinta-suave); padding-top: 2px; }

  .botao-todas { display: none; align-items: center; justify-content: center; min-height: 52px; border-radius: 10px; background: var(--acento); color: #fff; font-weight: 700; text-decoration: none; }
  .botao-todas:hover { background: var(--acento-hover); color: #fff; }

  .como { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 24px; border-top: 2px solid var(--tinta); padding-top: 24px; }
  .como div { display: flex; flex-direction: column; gap: 6px; }
  .como p { margin: 0; color: var(--tinta-2); font-size: 15px; }

  @media (max-width: 600px) {
    .tese { display: none; }
    .data { font-size: 12px; }
    .oportunidades { margin-top: -16px; }
    .painel { padding: 18px; gap: 14px; flex-basis: 100%; }
    .h2-menor { font-size: 22px; }
    .botao-todas { display: flex; }
    .duas-colunas { gap: 28px; }
  }
</style>
